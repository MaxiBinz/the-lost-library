{"created": "2026-03-16T09:27:17.608923+00:00", "modified": "2026-03-16T09:27:19.418170+00:00", "id": 19047125, "conceptrecid": "17701359", "doi": "10.5281/zenodo.19047125", "conceptdoi": "10.5281/zenodo.17701359", "doi_url": "https://doi.org/10.5281/zenodo.19047125", "metadata": {"title": "Raw-Metadata-BOMPAC", "doi": "10.5281/zenodo.19047125", "publication_date": "2026-03-16", "description": "<p><span lang=\"EN-GB\">The <em>Books of the Medieval Parish Church</em> (BOMPAC) project (2021&ndash;2025), hosted by the National Library of Finland, systematically produced and edited metadata on medieval parchment fragments reused by the Swedish tax administration as soft covers for account booklets between c. 1540 and 1630. For the most part, these fragments are listed in either the <em>Medeltida pergamentomslag </em>(National Archives of Sweden) or the <em>Fragmenta membranea</em> (National Library of Finland) database. </span></p>\n<p>This dataset presents the project&rsquo;s research data, in lightly edited form, as it stood at the conclusion of the project.</p>\n<p>Version v1.1: adds the data in csv format with the data unchanged.</p>", "access_right": "open", "creators": [{"name": "Eskola, Seppo", "affiliation": "University of Helsinki", "orcid": "0009-0001-7084-5821"}, {"name": "Kaasik, Holger", "affiliation": null}, {"name": "Tahkokallio, Jaakko", "affiliation": "University of Helsinki", "orcid": "0000-0001-8974-8020"}], "contributors": [{"name": "R\u00e4m\u00f6, Susanna", "affiliation": null, "type": "DataCollector"}, {"name": "von Hertzen, Maria", "affiliation": null, "type": "DataCollector"}, {"name": "Stjernberg, Robert", "affiliation": null, "type": "DataCollector"}, {"name": "Fougstedt, Daniela", "affiliation": null, "type": "DataCollector"}], "version": "v1.1", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "948497", "internal_id": "10.13039/501100000780::948497", "funder": {"name": "European Co