{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lost-library:knowledge.schema.v1",
  "title": "Lost Library manuscript knowledge overlay v1",
  "type": "object",
  "required": [
    "version",
    "assessment_date",
    "entities",
    "claims",
    "evidence",
    "dependencies",
    "input_snapshots",
    "frozen_inputs",
    "semantics"
  ],
  "properties": {
    "version": {
      "const": "1.25.0"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "properties": {
          "type": {
            "enum": [
              "Agent",
              "Capture",
              "CatalogRecord",
              "Chant",
              "Codex",
              "FragmentSet",
              "Identifier",
              "ImageDerivative",
              "Leaf",
              "Method",
              "PhysicalFragment",
              "ResearchQuestion",
              "Side",
              "Source",
              "StylisticGroup"
            ]
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject",
          "predicate",
          "object",
          "basis",
          "status",
          "source_stance",
          "polarity",
          "attributed_to",
          "recorded_at",
          "source_statement_date",
          "scope",
          "provenance",
          "supports",
          "challenges"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "object": {
            "type": "string"
          },
          "predicate": {
            "enum": [
              "assigned_to_reconstruction",
              "capture_of",
              "chant_identification",
              "derivative_of",
              "describes",
              "liturgical_relationship",
              "member_of_group",
              "method_correction",
              "numbering_conflict",
              "melodic_excerpt_comparison",
              "part_of",
              "physical_join",
              "photographic_overlap",
              "same_codex",
              "same_hand",
              "stylistic_similarity",
              "suggested_association",
              "textual_continuation"
            ]
          },
          "basis": {
            "enum": [
              "computational_suggestion",
              "project_observation",
              "researcher_interpretation",
              "source_assertion"
            ]
          },
          "status": {
            "enum": [
              "contradicted",
              "not_testable",
              "previously_documented",
              "supported",
              "unresolved"
            ]
          },
          "source_stance": {
            "enum": [
              "asserted",
              "suggested",
              "rejected",
              "unknown"
            ]
          },
          "polarity": {
            "enum": [
              "positive",
              "negative",
              "unknown"
            ]
          },
          "source_statement_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "type": "array",
            "minItems": 1
          },
          "supports": {
            "type": "array"
          },
          "challenges": {
            "type": "array"
          }
        },
        "not": {
          "required": [
            "confidence"
          ]
        }
      }
    },
    "evidence": {
      "type": "array"
    },
    "dependencies": {
      "type": "array"
    },
    "semantics": {
      "type": "object",
      "properties": {
        "open_world": {
          "const": true
        },
        "identity_closure": {
          "const": false
        },
        "scores_are_confidence": {
          "const": false
        }
      }
    }
  },
  "$comment": "The shipped knowledge validator additionally checks referential integrity, complete lead coverage, frozen/source hashes and source-image regions. No network schema resolution is required."
}
