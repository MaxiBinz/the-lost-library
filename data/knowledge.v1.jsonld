      },
      "details": "{\"id\": \"interpretation:E40-boundary\", \"subject\": \"object:mpo-8994\", \"predicate\": \"textual_continuation\", \"object\": \"leaf:fm-IV.156-9\", \"basis\": \"researcher_interpretation\", \"status\": \"unresolved\", \"source_stance\": \"suggested\", \"polarity\": \"positive\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"source_statement_date\": null, \"scope\": \"Observed Swedish terminal words compared with an indexed Finnish catalogue boundary and known chant text\", \"provenance\": [{\"source\": \"source:a4478802f2c0570648f6\", \"locator\": null}], \"supports\": [\"evidence:I40-8994-nocte\", \"evidence:I40-8994-passion\", \"evidence:I40-8994-contemplatur\", \"evidence:I40-8994-tempus-est\", \"evidence:I40-8994-exultabat\"], \"challenges\": [], \"limits\": [\"Swedish source pixels, Finnish catalogue assertions, known-office concordances and new interpretation are separate evidence bases.\", \"The terminal row is the last visible row of capture4, not an independently verified complete medieval-side ending; folds, hidden text and capture mapping remain unresolved.\", \"No IV156 f9 original image, complete leading signature or physical join is verified. The uncertain numeral is not silently read as V.\", \"Ordinary common chant text can recur in different books; the fit is more precise than shared feast identity but cannot establish one codex.\", \"IV157 ff9–10 supplies overlapping Egregius content, not the same proposed terminal-to-opening boundary; E33’s f8 conflict remains conditional on its original premises.\", \"No exact Fr20278 image was found; missing access is not negative historical evidence.\", \"Relevant Taitto/Keskiaho passages remain unread; a missing shelfmark in another text search does not clear novelty.\", \"Single AI exploratory reading, not independent expert confirmation. No frozen ambiguous case is resolved.\", \"There are faint ochre marks after the last clearly read tempus est. A concordance-exposed ut is only a candidate; the marks have not been established as writing. The E40 description of an absolute visible endpoint should be read as the last clearly transcribed word. The marks cannot yet support or disprove an immediate text continuation; different layers, cue, offset or damage remain live alternatives.\", \"This source supplies relevant historical and methodological prior art but does not by itself establish the Fr8994/IV156 relationship, original page sequence, a physical join, a production site or a use site. Exact f9 evidence and unread Taitto/Keskiaho publications remain required for their affected claims.\"], \"local_observation_state\": \"supported\", \"physical_adjacency_established\": false, \"physical_join_established\": false, \"complete_leaf_edge_verified\": false, \"signature_successor_verified\": false, \"test_prediction\": {\"predicted_next_recto_numeral\": \"V\", \"status\": \"conditional prediction, not an observed or normalized catalogue reading\", \"premises\": [\"Fr8994 is one correctly mapped leaf with IIII on its recto and the k-bearing later view on its verso.\", \"The two sources use the same uninterrupted opening-signature series in this section.\", \"The capture4 terminal row is the actual end of that verso.\"], \"explanation\": \"Under the documented opening-signature convention, that verso would form the next opening with a V-bearing recto. The uncertain Finnish OCR is not evidence that this prediction is met.\", \"prediction_verified\": false}, \"independent_confirmation\": false}"
    },
