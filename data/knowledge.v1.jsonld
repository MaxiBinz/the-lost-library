      "status": "previously_documented",
      "basis": "researcher_interpretation",
      "polarity": "positive",
      "attributedTo": {
        "@id": "urn:lost-library:agent%3Aproject-ai"
      },
      "details": "{\"id\": \"claim:pair-00a2bc1211763a926f46\", \"subject\": \"object:mpo-7960\", \"predicate\": \"same_codex\", \"object\": \"object:mpo-7961\", \"basis\": \"researcher_interpretation\", \"status\": \"previously_documented\", \"source_stance\": \"asserted\", \"polarity\": \"positive\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"source_statement_date\": null, \"scope\": \"book relationship\", \"provenance\": [{\"source\": \"source:d94dbd9171cf5d966199\", \"locator\": \"pair-00a2bc1211763a926f46\"}], \"supports\": [], \"challenges\": [], \"support_notes\": [\"manuscript type: compatibility 1.000; this is not an identity probability.\", \"script: compatibility 1.000; this is not an identity probability.\", \"notation: compatibility 1.000; this is not an identity probability.\", \"staff_lines: compatibility 1.000; this is not an identity probability.\", \"columns: compatibility 1.000; this is not an identity probability.\", \"lines: compatibility 1.000; this is not an identity probability.\", \"leaf_cm: compatibility 0.921; this is not an identity probability.\", \"written_cm: compatibility 0.813; this is not an identity probability.\", \"catalogue date range: compatibility 1.000; this is not an identity probability.\", \"Catalogue type: Graduale / Graduale.\", \"Notation: Quadr / Quadr.\", \"The final Esto mihi row ends refugium meum. A separate catchword es tu repeats the beginning of the next object's first text row, which continues et propter nomen tuum. This supports the already catalogued directional textual continuation.\"], \"challenge_notes\": [\"Compatibility score is not an identity probability.\", \"Text/chant continuity, individual letterforms and physical joins have not been independently verified.\", \"Current target-specific novelty is uncleared until later scholarship and expert review.\", \"Image similarity can reflect shared script, notation, damage, capture background or workshop rather than one codex.\", \"Source metadata may inherit reconstructed-group descriptions; it is not independent physical evidence.\", \"No external specialist has adjudicated this computational suggestion.\", \"The chant and two-word catchword are not unique book fingerprints.\", \"Text continuation plus catchword does not establish a physical seam or independent attribution.\", \"The mapped catalogue side remains a content-based interpretation; capture ordinal supplies no side rule.\"], \"source_locator\": null, \"contextual_evidence\": [], \"lead_id\": \"pair-00a2bc1211763a926f46\"}"
    },
