29d9feb2560c88c6b24937ab52e89f14db17e890a55aec30dbe1c78\", \"image_dimensions\": [1880, 997], \"rights_url\": \"http://creativecommons.org/publicdomain/mark/1.0/\", \"attribution\": \"Riksarkivet; National Archives of Sweden\", \"literal_candidate\": \"Lapides preciosi [...] [V?] Domus me[...] [marker?] Domus or[...] Ad bened[...] ant[...] Mane surgens Iacob [...]\", \"normalized_candidate\": null, \"observer\": \"Codex AI; reference-exposed reading, 2026-11-02; exact model checkpoint unavailable\", \"independent_confirmation\": false, \"interpretation_limits\": [\"The small markers and abbreviations require independent verification; neither Cantus ID nor missing words are image-confirmed.\", \"The relation to capture 1 and the presence or absence of a full Domus mea antiphon around the fold remain unverified.\"]}, \"independent_confirmation\": false}, {\"id\": \"evidence:I79-10437-hec\", \"type\": \"EvidenceRegion\", \"basis\": \"project_observation\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"annotation_id\": \"I79-10437-hec\", \"image\": \"image:research/continuation_54/images/Fr10437-capture-1-native.jpg\", \"target\": {\"source\": \"research/continuation_54/images/Fr10437-capture-1-native.jpg\", \"selector\": {\"type\": \"FragmentSelector\", \"conformsTo\": \"http://www.w3.org/TR/media-frags/\", \"value\": \"xywh=770,720,400,170\"}}, \"sha256\": \"75d3c9b2ae0facd754504b1dec68ce8a33a64d3cdaa7a78140c9ab539942224a\", \"observation\": \"Four candidate square noteheads over Hec / est / do- / mus; third is visually lower relative to the adjacent rule, then the fourth returns higher.\", \"literal_candidate\": \"Hec est domus [...]\", \"normalized_candidate\": null, \"source_url\": \"https://lbiiif.riksarkivet.se/arkis!R1010437_00001/full/max/0/default.jpg\", \"import_date\": \"2026-11-02\", \"original_annotation\": {\"id\": \"I79-10437-hec\", \"type\": \"Annotation\", \"motivation\": \"describing\", \"fragment_id\": \"mpo-10437\", \"b