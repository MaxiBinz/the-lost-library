      "details": "{\"id\": \"claim:pair-3e9dcb9afd694419da7a\", \"subject\": \"object:mpo-10406\", \"predicate\": \"same_codex\", \"object\": \"object:mpo-1385\", \"basis\": \"researcher_interpretation\", \"status\": \"unresolved\", \"source_stance\": \"suggested\", \"polarity\": \"positive\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"source_statement_date\": null, \"scope\": \"book relationship\", \"provenance\": [{\"source\": \"source:36fb90793e201dc844e5\", \"locator\": \"H02\"}], \"supports\": [], \"challenges\": [], \"support_notes\": [\"Fr10406 has an inspectable red liturgical rubric and layout resemblance to Fr1385. The source notes already cite this comparison.\", \"Selected initials share pale-grey shafts, red stripes/lozenges and black scalloping. Four staff windows per capture, normalized by approximate ruler intervals, show no gross ruling-scale incompatibility; endpoint perturbation ranges overlap.\", \"A controlled candidate A-to-A comparison retains specific Fr1385/10406 resemblance; the selected Ant39 A examples differ. Exact decorative-function equivalence and A-specific exclusivity remain unverified.\"], \"challenge_notes\": [\"Shared production, same chant tradition and inherited descriptions remain live explanations. No chant-boundary join established.\", \"Related ornamental traits also occur among Ant39 controls. Ruler readings are approximate and perspective is not calibrated; no certified physical size, same hand or same book is established.\", \"The published wrong-book pair repeats the richer motif vocabulary in separate D-to-D samples. This is a different-letter-class control, not an A-specific counterexample. Selected post-review decoration cannot establish identity.\"], \"source_locator\": null, \"contextual_evidence\": [\"evidence:O-mpo-1385\", \"evidence:O-mpo-10406-1-8\", \"evidence:V-1385-clipped-mark\", \"evidence:V-H02-1385-initial-a\", \"evidence:V-H02-10406-initial-a\", \"evidence:V-H02-1385-initial-b\", \"evidence:V-H02-10406-initial-b\", \"evidence:V-H02-1385-ruling\", \"evidence:V-H02-10406-ruling\", \"evidence:V-H02-1385-ruler\", \"evidence:V-H02-10406-ruler\", \"evidence:C20-A-1385\", \"evidence:C20-A-10406\"], \"lead_id\": \"pair-3e9dcb9afd694419da7a\"}"
