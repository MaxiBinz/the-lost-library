      },
      "details": "{\"id\": \"claim:pair-f0c68032e0ed8b1524ef\", \"subject\": \"object:finn-iv173\", \"predicate\": \"same_codex\", \"object\": \"object:mpo-25592\", \"basis\": \"researcher_interpretation\", \"status\": \"unresolved\", \"source_stance\": \"suggested\", \"polarity\": \"positive\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"source_statement_date\": null, \"scope\": \"book relationship\", \"provenance\": [{\"source\": \"source:36fb90793e201dc844e5\", \"locator\": \"H05\"}], \"supports\": [], \"challenges\": [], \"support_notes\": [\"The Finnish leaf has large one-column music systems; all four Fr25592 photographs consistently show a much denser two-column hymn layout.\", \"A full-deposit crosswalk uniquely maps Hy49 to Fr25592. The Finnish source distinguishes accepted Ant242/Fr29666 from suggested Hy49 and Ant99 relations; a unique identifier does not resolve that historical suggestion.\", \"E27 verifies BOMPAC-9531 contains all three rows: Fr 25592/Hy 49, Fr 29666/Ant 242 and F.m.IV.173, fol. 1. The Fr 29666 note cites Taitto 2001 p.185 for its same-codex link to IV.173.\"], \"challenge_notes\": [\"A date/alias error, composite book or differing section could explain conflict. No physical exclusion proof.\", \"The actual captures still show a one-column music layout for IV.173 and a much denser two-column hymn layout for Fr 25592, and the catalogue dating for Fr 25592 conflicts with the proposed fifteenth-century group. BOMPAC's unit is a research reconstruction, not direct proof that these differences are compatible within one codex.\", \"The official Fragmenta catalogue describes IV.156 and IV.157 as stylistically similar but does not say they are the same codex; Codex 1505 is listed as a suggestion, while other links receive explicit same-codex labels.\"], \"source_locator\": null, \"contextual_evidence\": [\"evidence:O-mpo-25592\", \"evidence:O-finn-iv173-1-10\"], \"lead_id\": \"pair-f0c68032e0ed8b1524ef\"}"
    },
