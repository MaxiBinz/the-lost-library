rison\", \"verification\": \"Provisional AI source reading; no independent expert adjudication\", \"reading\": {\"literal_candidate\": \"oneratus mesta matre comitatus dampnatur innoxius\", \"normalized_search_text\": \"oneratus mesta matre comitatus dampnatur innoxius\", \"certainty\": \"Provisional reading; abbreviation expansion, erasures and underlay limits are explicit\", \"external_references\": [\"https://lup.lub.lu.se/student-papers/record/9032430/file/9032431.pdf#page=67\", \"https://www.alvin-portal.org/alvin/view.jsf?pid=alvin-record:160517\"]}, \"interpretation_limits\": [\"dampn- spelling is provisional and not asserted to be rare.\", \"Medieval manuscript words are public-domain source text; modern editorial readings remain separately attributed.\", \"No same-book, direct-copy, stemma, rarity, melodic or performance inference.\"]}, \"independent_confirmation\": false}, {\"id\": \"evidence:T-20274-eructavit-rident\", \"type\": \"EvidenceRegion\", \"basis\": \"project_observation\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"annotation_id\": \"T-20274-eructavit-rident\", \"image\": \"image:data/images/mpo-20274-capture-2-1835px.jpg\", \"target\": {\"source\": \"data/images/mpo-20274-capture-2-1835px.jpg\", \"selector\": {\"type\": \"FragmentSelector\", \"conformsTo\": \"http://www.w3.org/TR/media-frags/\", \"value\": \"xywh=300,1080,1360,210\"}}, \"sha256\": \"34f88c2977098a87fbc5c2fb796f05092cc83e49574bef2d2e3ac19efe156457\", \"observation\": \"A psalm cue Eructavit is followed by Calvum rident. This is a current visible sequence shared with C23; source underlay and word endings remain provisional.\", \"literal_candidate\": null, \"normalized_candidate\": null, \"source_url\": \"https://lbiiif.riksarkivet.se/v3/arkis!R1020274_00002/full/1835,/0/default.jpg\", \"import_date\": \"2026-11-02\", \"original_annotation\": {\"id\": \"T-20274-eructavit-rident\", \"type\": \"Annotation\", \"motivation\": \"describing\", \"fragment_id\": \"mpo-20274\", \"review_pair_ids\": [\"H01\", \"H03\"], \"body\": {\"type\": \"TextualBody\", \"value\": \"A psalm cue Eructavit is followed by Calvum rident. This is a current visible sequence shared with C23; source underlay and word endings remain provisional.\", \"language\": \"en\"}, \"target\": {\"source\": \"data/images/mpo-20274-capture-2-1835px.jpg\", \"selector\": {\"type\": \"FragmentSelector\", \"conformsTo\": \"http://www.w3.org/TR/media-frags/\", \"value\": \"xywh=300,1080,1360,210\"}}, \"source_url\": \"https://lbiiif.riksarkivet.se/v3/arkis!R1020274_00002/full/1835,/0/default.jpg\", \"sha256\": \"34f88c2977098a87fbc5c2fb796f05092cc83e49574bef2d2e3ac19efe156457\", \"image_dimensions\": [1835, 1705], \"observer\": \"Codex AI source comparison,2026-10-23; exact model/checkpoint not exposed\", \"evidence_kind\": \"C23 source comparison\", \"verification\": \"Provisional AI source reading; no independent expert adjudication\", \"reading\": {\"literal_candidate\": \"alleluya; ps[almus] Eructauit; Calvum rident helise[...]\", \"normalized_search_text\": \"alleluya; ps[almus] Eructauit; Calvum rident helise[...]\", \"certainty\": \"Provisional reading; abbreviation expansion, erasures and underlay limits are explicit\", \"external_references\": [\"https://lup.lub.lu.se/student-papers/record/9032430/file/9032431.pdf#page=67\", \"https://www.alvin-portal.org/alvin/view.jsf?pid=alvin-record:160517\"]}, \"interpretation_limits\": [\"No melodic variant or special copy relationship established.\", \"Medieval manuscript words are public-domain source text; modern editorial readings remain separately attributed.\", \"No same-book, direct-copy, stemma, rarity, melodic or performance inference.\"]}, \"independent_confirmation\": false}, {\"id\": \"evidence:I21-10370-staff-pitch\", \"type\": \"EvidenceRegion\", \"basis\": \"project_observation\", \"attributed_to\": \"agent:project-ai\", \"recorded_at\": \"2026-11-02\", \"annotation_id\": \"I21-10370-staff-pitch